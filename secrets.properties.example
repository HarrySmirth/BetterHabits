# Copy to secrets.properties (git-ignored) and fill in.
# Supabase dashboard -> Project Settings -> API. Use the PUBLISHABLE (anon) key only.
# Never put the service-role / secret key anywhere in this repository or the app.
supabase.url=https://YOUR-PROJECT-REF.supabase.co
supabase.publishableKey=sb_publishable_...

# Optional: Google sign-in. The OAuth *Web application* client ID from Google Cloud Console
# (the same one configured in Supabase -> Authentication -> Providers -> Google). Leave empty to hide the button.
google.webClientId=
