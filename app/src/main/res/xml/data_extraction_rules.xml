<?xml version="1.0" encoding="utf-8"?>
<!--
    Supabase is the source of truth. Restoring a cached session, local database or pending sync
    queue onto another device would be stale at best and a security risk at worst, so nothing is
    backed up or transferred.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
